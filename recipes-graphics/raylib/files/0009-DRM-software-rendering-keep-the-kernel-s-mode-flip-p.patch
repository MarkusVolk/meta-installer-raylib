+// Select the connector mode for the requested screen size
+// NOTE: The mode currently shown is preferred when it fits. The kernel has chosen it already,
+// e.g. from video= on the command line, and a display often lists several modes with the
+// same size and refresh rate but different timings, which not all displays show correctly
+static int SelectConnectorMode(void)
+{
+    int currentIndex = -1;
+
+    if ((platform.crtc != NULL) && platform.crtc->mode_valid)
+    {
+        const drmModeModeInfo *const current = &platform.crtc->mode;
+
+        for (int i = 0; i < platform.connector->count_modes; i++)
+        {
+            const drmModeModeInfo *const mode = &platform.connector->modes[i];
+
+            if ((mode->clock == current->clock) && (mode->flags == current->flags) &&
