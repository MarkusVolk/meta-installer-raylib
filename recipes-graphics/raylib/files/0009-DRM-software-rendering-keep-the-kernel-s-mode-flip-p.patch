+#if defined(GRAPHICS_API_OPENGL_SOFTWARE)
+// Create a dumb buffer with a framebuffer on top and map it into userspace
+static int CreateDumbBuffer(DumbBuffer *buffer, uint32_t width, uint32_t height)
+{
+    struct drm_mode_create_dumb creq = { 0 };
+    creq.width = width;
+    creq.height = height;
+    creq.bpp = 32;      // 32 bits per pixel (XRGB8888 format)
+
+    if (drmIoctl(platform.fd, DRM_IOCTL_MODE_CREATE_DUMB, &creq) < 0)
+    {
+        TRACELOG(LOG_ERROR, "DISPLAY: Failed to create dumb buffer: %s", strerror(errno));
+        return -1;
+    }
+
+    buffer->handle = creq.handle;
+    buffer->size = creq.size;
+
+    // NOTE: The blit writes rows without padding
+    if (creq.pitch != width*4) TRACELOG(LOG_WARNING, "DISPLAY: Dumb buffer pitch %u differs from the row size %u", creq.pitch, width*4);
+
+    // Color depth 24 bits, alpha is not used
+    if (drmModeAddFB(platform.fd, width, height, 24, 32, creq.pitch, creq.handle, &buffer->fb) != 0)
+    {
+        TRACELOG(LOG_ERROR, "DISPLAY: drmModeAddFB() failed: %s", strerror(errno));
+        return -1;
+    }
+
+    struct drm_mode_map_dumb mreq = { 0 };
+    mreq.handle = creq.handle;
+    if (drmIoctl(platform.fd, DRM_IOCTL_MODE_MAP_DUMB, &mreq) != 0)
+    {
+        TRACELOG(LOG_ERROR, "DISPLAY: Failed to map dumb buffer: %s", strerror(errno));
+        return -1;
+    }
+
+    void *map = mmap(0, creq.size, PROT_READ | PROT_WRITE, MAP_SHARED, platform.fd, mreq.offset);
+    if (map == MAP_FAILED)
+    {
+        TRACELOG(LOG_ERROR, "DISPLAY: Failed to mmap dumb buffer: %s", strerror(errno));
+        return -1;
+    }
+
+    buffer->map = map;
+
+    return 0;
+}
+
+// Unmap and free the dumb buffers and their framebuffers
+static void DestroyDumbBuffers(void)
+{
+    for (int i = 0; i < DRM_SW_BUFFERS; i++)
+    {
+        DumbBuffer *buffer = &platform.dumb[i];
+
+        if (buffer->map) munmap(buffer->map, buffer->size);
+        if (buffer->fb) drmModeRmFB(platform.fd, buffer->fb);
+        if (buffer->handle)
+        {
+            struct drm_mode_destroy_dumb dreq = { 0 };
+            dreq.handle = buffer->handle;
+            drmIoctl(platform.fd, DRM_IOCTL_MODE_DESTROY_DUMB, &dreq);
+        }
+
+        memset(buffer, 0, sizeof(*buffer));
+    }
+
+    platform.dumbReady = false;
+    platform.dumbFlipPending = false;
+}
+
+static void SoftwarePageFlipHandler(int fd, unsigned int frame, unsigned int sec, unsigned int usec, void *data)
+{
+    (void)fd;
+    (void)frame;
+    (void)sec;
+    (void)usec;
+    (void)data;
+
+    platform.dumbFlipPending = false;
+}
+
+// Wait for the queued page flip, at most a few frames
+static void WaitSoftwarePageFlip(void)
+{
+    drmEventContext evctx = { 0 };
+    evctx.version = 2;
+    evctx.page_flip_handler = SoftwarePageFlipHandler;
+
+    struct pollfd pfd = { .fd = platform.fd, .events = POLLIN };
+
+    while (platform.dumbFlipPending)
+    {
+        int result = poll(&pfd, 1, 100);
+
+        if ((result < 0) && (errno == EINTR)) continue;
+        if (result <= 0)
+        {
+            // Nothing arrived, do not block the application forever
+            TRACELOG(LOG_WARNING, "DISPLAY: Page flip did not complete");
+            platform.dumbFlipPending = false;
+            break;
+        }
+
+        drmHandleEvent(platform.fd, &evctx);
+    }
+}
+
+// Get the CRTC to use for software rendering, the connector may have no encoder
+static uint32_t FindSoftwareCrtc(void)
+{
+    if (platform.crtc) return platform.crtc->crtc_id;
+
+    drmModeRes *res = drmModeGetResources(platform.fd);
+    if (!res)
+    {
+        TRACELOG(LOG_ERROR, "DISPLAY: Failed to get DRM resources");
+        return 0;
+    }
+
+    uint32_t crtcId = 0;
+
+    // Check which CRTCs are compatible with this connector
+    drmModeEncoder *encoder = NULL;
+    if (platform.connector->encoder_id) encoder = drmModeGetEncoder(platform.fd, platform.connector->encoder_id);
+
+    if (encoder && encoder->crtc_id)
+    {
+        crtcId = encoder->crtc_id;
+        platform.crtc = drmModeGetCrtc(platform.fd, crtcId);
+    }
+    else
+    {
+        // Find a free CRTC
+        for (int i = 0; i < res->count_crtcs; i++)
+        {
+            drmModeCrtc *crtc = drmModeGetCrtc(platform.fd, res->crtcs[i]);
+            if (crtc && !crtc->buffer_id) // CRTC is free
+            {
+                crtcId = res->crtcs[i];
+                platform.crtc = crtc;
+                break;
+            }
+
+            if (crtc) drmModeFreeCrtc(crtc);
+        }
+    }
+
+    if (encoder) drmModeFreeEncoder(encoder);
+    drmModeFreeResources(res);
+
+    return crtcId;
+}
