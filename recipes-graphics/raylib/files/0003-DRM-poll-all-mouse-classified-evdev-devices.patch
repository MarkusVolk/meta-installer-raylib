index 8a0ac678..fd3c31e1 100644
--- a/src/platforms/rcore_drm.c
+++ b/src/platforms/rcore_drm.c
@@ -142,9 +142,22 @@ typedef struct {
     // NOTE: currentButtonState[] can't be written directly due to multithreading, app could miss the update
     char currentButtonStateEvdev[MAX_MOUSE_BUTTONS]; // Holds the new mouse state for the next polling event to grab
     bool cursorRelative;                // Relative cursor mode
-    int mouseFd;                        // File descriptor for the evdev mouse/touch/gestures
+    int mouseFd;                        // File descriptor for the evdev touch/gesture device (touch devices only from here on - see mouseFds[] below for regular mice)
     bool mouseIsTouch;                  // Check if the current mouse device is actually a touchscreen
     Rectangle absRange;                 // Range of values for absolute pointing devices (touchscreens)
+    // PATCH: mehrere gleichzeitig als (nicht-Touch-)Maus erkannte
+    // evdev-Interfaces pollen statt nur das zuletzt gefundene zu
+    // behalten (vorheriges Verhalten: jedes neue erkannte Maus-Geraet
