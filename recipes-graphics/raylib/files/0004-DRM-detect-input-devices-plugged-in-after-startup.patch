     Vector2 touchPosition[MAX_TOUCH_POINTS]; // Track touch positions for each slot
@@ -321,6 +335,7 @@ static void ProcessKeyboard(void);              // Process keyboard events
 
 // Input management functions
 static void InitEvdevInput(void);               // Initialize evdev inputs
+static void RescanEvdevInputForNewDevices(void); // PATCH: periodically detect input devices plugged in after startup
 static void ConfigureEvdevDevice(char *device); // Identifies a input device and configures it for use if appropriate
 static void PollKeyboardEvents(void);           // Process evdev keyboard events
 static void PollGamepadEvents(void);            // Process evdev gamepad events
@@ -1133,6 +1148,22 @@ void PollInputEvents(void)
     CORE.Input.Gamepad.lastButtonPressed = 0;       // GAMEPAD_BUTTON_UNKNOWN
     //CORE.Input.Gamepad.axisCount = 0;
 
+    // PATCH: periodically check for input devices plugged in after
+    // startup (see RescanEvdevInputForNewDevices()'s own comments) -
+    // throttled to once every 2 seconds rather than every frame, to
+    // avoid the overhead of a directory scan ~60 times a second for
+    // something that only needs to be noticed within a couple of
+    // seconds of a human actually plugging something in.
+    {
+        static double lastEvdevRescanTime = 0.0;
+        double now = GetTime();
+        if (now - lastEvdevRescanTime >= 2.0)
+        {
+            RescanEvdevInputForNewDevices();
+            lastEvdevRescanTime = now;
+        }
+    }
+
     // Register previous keys states
     for (int i = 0; i < MAX_KEYBOARD_KEYS; i++)
     {
@@ -1976,6 +2007,7 @@ static void InitEvdevInput(void)
     platform.mouseFd = -1;
     platform.mouseFdCount = 0;
     for (int i = 0; i < MAX_MOUSE_FDS; i++) platform.mouseFds[i] = -1;
+    platform.knownEvdevPathCount = 0;
 
     // Reset variables
     for (int i = 0; i < MAX_TOUCH_POINTS; i++)
@@ -2018,6 +2050,52 @@ static void InitEvdevInput(void)
     else TRACELOG(LOG_WARNING, "INPUT: Failed to open linux event directory: %s", DEFAULT_EVDEV_PATH);
 }
 
+// PATCH: periodically re-scans /dev/input for devices not already
+// tracked in platform.knownEvdevPaths[] (populated by
+// ConfigureEvdevDevice() for every device it accepts) and configures
+// only the genuinely new ones - InitEvdevInput() above only ever runs
+// once, at startup, so a device plugged in afterwards was previously
+// never found at all (confirmed on real hardware: a keyboard plugged
+// in after boot not being recognized). Deliberately a simple,
+// throttled directory re-scan (see its call site for the timing)
+// rather than a netlink/uevent-based listener - much less code and
+// much easier to reason about correctness of, and more than
+// responsive enough for a human plugging in a device and expecting it
+// to work within a couple of seconds, which is the actual real-world
+// need here (this is not a high-frequency hotplug scenario).
+static void RescanEvdevInputForNewDevices(void)
+{
+    char path[MAX_FILEPATH_LENGTH] = { 0 };
+    DIR *directory = NULL;
+    struct dirent *entity = NULL;
+
+    directory = opendir(DEFAULT_EVDEV_PATH);
+    if (!directory) return;
+
+    while ((entity = readdir(directory)) != NULL)
+    {
+        if ((strncmp("event", entity->d_name, strlen("event")) == 0) ||
+            (strncmp("mouse", entity->d_name, strlen("mouse")) == 0))
+        {
+            snprintf(path, MAX_FILEPATH_LENGTH, "%s%s", DEFAULT_EVDEV_PATH, entity->d_name);
+
+            bool alreadyKnown = false;
+            for (int i = 0; i < platform.knownEvdevPathCount; i++)
+            {
+                if (strncmp(platform.knownEvdevPaths[i], path, EVDEV_PATH_MAXLEN) == 0)
+                {
+                    alreadyKnown = true;
+                    break;
+                }
+            }
+
+            if (!alreadyKnown) ConfigureEvdevDevice(path);   // New device - classify and add it exactly like at startup
+        }
+    }
+
+    closedir(directory);
+}
+
 // Identifies a input device and configures it for use if appropriate
 static void ConfigureEvdevDevice(char *device)
 {
@@ -2185,8 +2263,6 @@ static void ConfigureEvdevDevice(char *device)
             platform.absRange.y = absinfo[ABS_Y].info.minimum;
             platform.absRange.height = absinfo[ABS_Y].info.maximum - absinfo[ABS_Y].info.minimum;
         }
-
-        TRACELOG(LOG_INFO, "INPUT: Initialized input device %s as %s", device, deviceKindStr);
     }
     else if (isMouse)
     {
@@ -2214,6 +2290,7 @@ static void ConfigureEvdevDevice(char *device)
         {
             platform.mouseFds[platform.mouseFdCount] = fd;
             platform.mouseFdCount++;
+            deviceKindStr = "mouse";
 
             if (absAxisCount > 0)
             {
@@ -2223,8 +2300,6 @@ static void ConfigureEvdevDevice(char *device)
                 platform.absRange.y = absinfo[ABS_Y].info.minimum;
                 platform.absRange.height = absinfo[ABS_Y].info.maximum - absinfo[ABS_Y].info.minimum;
             }
-
-            TRACELOG(LOG_INFO, "INPUT: Initialized input device %s as mouse", device);
         }
         else
         {
@@ -2283,6 +2358,18 @@ static void ConfigureEvdevDevice(char *device)
         return;
     }
 
+    // PATCH: record this device's path so a later rescan (see
+    // RescanEvdevInputForNewDevices()) knows it's already been
+    // configured and won't try to re-open/re-add it - one shared
+    // place for all accepted device kinds (touch/mouse/gamepad/
+    // keyboard) rather than duplicating this in each branch above.
+    if (platform.knownEvdevPathCount < MAX_KNOWN_EVDEV_PATHS)
+    {
+        strncpy(platform.knownEvdevPaths[platform.knownEvdevPathCount], device, EVDEV_PATH_MAXLEN - 1);
+        platform.knownEvdevPaths[platform.knownEvdevPathCount][EVDEV_PATH_MAXLEN - 1] = '\0';
+        platform.knownEvdevPathCount++;
+    }
+
     TRACELOG(LOG_INFO, "INPUT: Initialized input device %s as %s", device, deviceKindStr);
 }
 
