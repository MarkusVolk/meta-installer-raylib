     #define MAX_MOUSE_FDS 8
     int mouseFds[MAX_MOUSE_FDS];
     int mouseFdCount;
+    // PATCH: track which /dev/input/event* paths have already been
+    // opened/classified, so a periodic rescan (see
+    // RescanEvdevInputForNewDevices() and its call site in
